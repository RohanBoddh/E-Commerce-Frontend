{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "/assets/images/favicon.svg"
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/images/favicon.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
